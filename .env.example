PORT=3000
DATABASE_PATH=data/gpt-money.sqlite
# Exactly 64 hexadecimal characters (32 bytes). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY_HEX=
OTP_TTL_SECONDS=300
OTP_POLL_INTERVAL_MS=6000
OTP_LOOKBACK_MINUTES=5
# Optional comma-separated sender fragments, e.g. no-reply@example.com,security@example.com
OTP_ALLOWED_SENDERS=
